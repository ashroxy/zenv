{
  "name": "zenv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:no-secrets": "node scripts/assert-no-bundled-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:no-secrets && npm run verify:no-remote-assets && npm run verify:android-manifests",
    "verify:no-remote-assets": "node scripts/assert-no-remote-assets.mjs",
    "verify:android": "npx cap sync android && cd android && gradlew.bat :app:processReleaseMainManifest :app:processDebugMainManifest --console=plain -q",
    "verify:android-manifests": "node scripts/assert-android-manifests.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
